# Port and Host for the FastAPI server
HOST=0.0.0.0
PORT=8000

# Allowed CORS origins (comma-separated list, e.g. https://my-voting-app.vercel.app)
# Use "*" to allow all origins (default)
ALLOWED_ORIGINS=*

# Custom database connection URL (defaults to local sqlite:///<base_dir>/voting.db)
# DATABASE_URL=sqlite:///voting.db
